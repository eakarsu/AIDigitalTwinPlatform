NODE_ENV=development
DATABASE_URL=postgresql://twin_user:change-me@localhost:5432/ai_digital_twin
JWT_SECRET=replace-with-at-least-32-random-characters
BACKEND_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
SEQUELIZE_SYNC=off
# Gateway, time-series, CAD/BIM, simulation, CMMS, and control adapters are external.
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
